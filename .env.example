# Server-side only. Never use a VITE_ prefix for these values.
RESEND_API_KEY=
# Use an address on a domain verified in Resend, e.g. Sıtkı Arslan Danışmanlık <form@your-domain.com>
CONTACT_FROM_EMAIL=
# Optional HTTPS Slack-compatible incoming webhook; server-side only.
# Leave blank to disable outbound alerts. Never use the customer email as a test target.
SECURITY_ALERT_WEBHOOK_URL=
